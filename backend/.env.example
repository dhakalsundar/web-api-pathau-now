# Backend Environment Configuration
# Copy this file to `.env` in the backend directory and update values

# Server Configuration
# Local: 5000 | Production: Should be set by platform
PORT=5000

# MongoDB Connection
# Local: mongodb://localhost:27017/database_name
# Production: Use managed MongoDB (MongoDB Atlas, AWS DocumentDB, etc.)
MONGO_URI=mongodb://localhost:27017/pathau_db

# JWT Secret for token signing
# IMPORTANT: Use a strong, random string in production
JWT_SECRET=your_jwt_secret_here_use_strong_random_string

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:3000
# Email Configuration (for OTP and notifications)
# SMTP Email Service - Gmail example below
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=s04105469@gmail.com
EMAIL_PASSWORD=kayc qidx swui rdmc
EMAIL_FROM=noreply@pathaunow.com

# For Gmail:
# 1. Enable 2FA: https://myaccount.google.com/
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Paste 16-character password as EMAIL_PASSWORD above

# For Outlook:
# EMAIL_HOST=smtp-mail.outlook.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@outlook.com
# EMAIL_PASSWORD=your-password

# OTP Configuration
OTP_EXPIRY_MINUTES=10